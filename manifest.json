{
  "manifest_version": 3,
  "name": "Franks ConnectWise",
  "version": "1.2.0",
  "description": "A configurable ConnectWise ticket and region link toolkit for Microsoft Edge.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://na.myconnectwise.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://na.myconnectwise.net/*"
      ],
      "js": [
        "tab-rename.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Franks ConnectWise",
    "default_popup": "popup.html"
  },
  "commands": {
    "select-links-in-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Select a region and open its links"
    }
  },
  "options_page": "options.html"
}
