{
  "manifest_version": 3,
  "name": "Franks ConnectWise",
  "version": "1.1.0",
  "description": "Open today's ConnectWise calendar tickets in a tab group and rename ticket tabs automatically.",
  "permissions": [
    "scripting",
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "https://na.myconnectwise.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://na.myconnectwise.net/*"
      ],
      "js": [
        "tab-rename.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Franks ConnectWise",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
